{
  "name": "@supersoniks/creative-stack",
  "version": "0.1.0",
  "description": "Addons créatifs et interactifs pour Concorde (3d, shader, webgpu, hugging-face-infer, interactive) et catalogue SDUI pour l'app Artefacts.",
  "license": "MIT",
  "type": "module",
  "repository": "github:ladigitale/creative-stack",
  "exports": {
    "./catalog.json": "./dist/catalog.json",
    "./3d": "./src/addons/3d/index.ts",
    "./2d": "./src/addons/2d/index.ts",
    "./shader": "./src/addons/shader/index.ts",
    "./webgpu": "./src/addons/webgpu/index.ts",
    "./interactive": "./src/addons/interactive/index.ts",
    "./hugging-face-infer": "./src/addons/hugging-face-infer/index.ts",
    "./hugging-face-infer/worker": "./src/addons/hugging-face-infer/hf-worker-runtime.ts",
    "./sound": "./src/addons/sound/index.ts",
    "./audio": "./src/addons/audio/index.ts",
    "./media": "./src/addons/media/index.ts",
    "./vision": "./src/addons/vision/index.ts",
    "./physics": "./src/addons/physics/index.ts",
    "./controller": "./src/addons/controller/index.ts",
    "./device": "./src/addons/device/index.ts",
    "./animation": "./src/addons/animation/index.ts",
    "./p2p": "./src/addons/p2p/index.ts",
    "./stage": "./src/addons/stage/index.ts",
    "./procgen": "./src/addons/procgen/index.ts",
    "./tape": "./src/addons/tape/index.ts",
    "./plot": "./src/addons/plot/index.ts",
    "./vector": "./src/addons/vector/index.ts",
    "./vectorize": "./src/addons/vectorize/index.ts",
    "./blobs": "./src/addons/blobs/index.ts",
    "./ocr": "./src/addons/ocr/index.ts",
    "./paint": "./src/addons/paint/index.ts",
    "./sketch": "./src/addons/sketch/index.ts",
    "./color": "./src/addons/color/index.ts",
    "./predict": "./src/addons/predict/index.ts",
    "./scroll": "./src/addons/scroll/index.ts",
    "./cursor": "./src/addons/cursor/index.ts",
    "./text": "./src/addons/text/index.ts",
    "./markdown": "./src/addons/markdown/index.ts",
    "./map": "./src/addons/map/index.ts",
    "./compat": "./src/shared/concorde-compat.ts",
    "./jsonata": "./src/shared/jsonata-shim.ts",
    "./shared/*": "./src/shared/*.ts",
    "./dist/*": "./dist/*",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "src",
    "dist",
    "schemas",
    "scripts/hf-vendor.mjs",
    "README.md"
  ],
  "scripts": {
    "dev": "vite --open demo/audio.html",
    "typecheck": "tsc --noEmit",
    "library:3d": "node src/addons/3d/library/generate.mjs",
    "catalog": "node scripts/build-catalog.mjs && node scripts/build-library.mjs",
    "build": "node scripts/build-catalog.mjs && node scripts/build-library.mjs && node scripts/build-addons.mjs",
    "test": "vitest",
    "test:ci": "node scripts/build-catalog.mjs && node scripts/build-library.mjs && node scripts/build-vectorize-worker.mjs --check && node scripts/build-sketch-worker.mjs --check && vitest run",
    "worker:vectorize": "node scripts/build-vectorize-worker.mjs",
    "worker:sketch": "node scripts/build-sketch-worker.mjs"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@supersoniks/concorde": ">=5.0.4 <7",
    "lit": "^3.1.3",
    "maplibre-gl": "5.24.0",
    "pixi.js": "8.19.0",
    "three": "0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonata": "^2.2.2",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "planck": "1.4.2",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@supersoniks/concorde": "^6.0.0",
    "@types/node": "^24.5.2",
    "@types/three": "0.180.0",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^26.0.0",
    "lit": "^3.1.3",
    "maplibre-gl": "5.24.0",
    "pixi.js": "8.19.0",
    "three": "0.180.0",
    "typescript": "^5.4.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
