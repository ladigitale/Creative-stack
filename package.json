{
  "name": "@supersoniks/creative-stack",
  "version": "0.1.0",
  "description": "Addons créatifs et interactifs pour Concorde (3d, shader, webgpu, hugging-face-infer, interactive) et catalogue SDUI pour l'app Artefacts.",
  "license": "MIT",
  "type": "module",
  "repository": "github:ladigitale/creative-stack",
  "exports": {
    "./catalog.json": "./dist/catalog.json",
    "./3d": "./src/addons/3d/index.ts",
    "./shader": "./src/addons/shader/index.ts",
    "./webgpu": "./src/addons/webgpu/index.ts",
    "./interactive": "./src/addons/interactive/index.ts",
    "./hugging-face-infer": "./src/addons/hugging-face-infer/index.ts",
    "./hugging-face-infer/worker": "./src/addons/hugging-face-infer/hf-worker-runtime.ts",
    "./shared/*": "./src/shared/*.ts",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "scripts/hf-vendor.mjs",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "catalog": "node scripts/build-catalog.mjs",
    "build": "node scripts/build-catalog.mjs && node scripts/build-addons.mjs",
    "test": "vitest",
    "test:ci": "node scripts/build-catalog.mjs && vitest run"
  },
  "peerDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@supersoniks/concorde": "^5.0.4",
    "lit": "^3.1.3",
    "three": "0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonata": "^2.2.2"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.0",
    "@supersoniks/concorde": "^5.0.4",
    "@types/node": "^24.5.2",
    "@types/three": "0.180.0",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^26.0.0",
    "lit": "^3.1.3",
    "three": "0.180.0",
    "typescript": "^5.4.3",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22"
}
