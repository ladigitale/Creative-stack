{
 "schema": "artifacts/1",
 "title": "Membres du GICAT par territoire",
 "defaultView": "carte",
 "page": {
  "padding": "compact"
 },
 "data": {
  "stores": {
   "etat": {
    "initial": {
     "parts": [],
     "sel": -1,
     "detOn": "false",
     "seq": 0
    },
    "reducer": "(\n  $t := $action.type; $p := $action.payload; $s := $state.seq + 1;\n  $t = 'select' ? $merge([$state, {'sel': $number($type($p) = 'object' ? $p.id : $p), 'detOn': 'true', 'seq': $s}])\n  : $t = 'close' ? $merge([$state, {'sel': -1, 'detOn': 'false', 'seq': $s}])\n  : $t = 'fit' ? $merge([$state, {'sel': -1, 'detOn': 'false', 'seq': $s}])\n  : $state\n)"
   },
   "fond": {
    "initial": {
     "style": "https://tiles.openfreemap.org/styles/positron"
    },
    "reducer": "$state"
   }
  }
 },
 "views": [
  {
   "id": "carte",
   "title": "Carte",
   "root": {
    "nodes": [
     {
      "tagName": "div",
      "attributes": {
       "style": "display:grid;gap:1rem"
      },
      "nodes": [
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "etat",
         "outputProvider": "bitd",
         "expression": "$reduce($input.parts, function($a, $p) { $append($a, $eval($p)) }, [])"
        }
       },
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "bitd",
         "formDataProvider": "filtres",
         "outputProvider": "liste",
         "expression": "( $qq := $lowercase($trim($string($exists($q) ? $q : '')));\n  $rr := $exists($reg) and $reg != null ? $reg : '';\n  $isDep := $contains($qq, /^([0-9]{2,3}|2[ab])$/);\n  $f := $input[($rr = '' or rg = $rr) and ($qq = '' or ($isDep ? $lowercase(d) = $qq : $contains(s, $qq)))]; $append([], $f[[0..149]]) )"
        }
       },
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "bitd",
         "formDataProvider": "filtres",
         "outputProvider": "pts",
         "expression": "( $qq := $lowercase($trim($string($exists($q) ? $q : '')));\n  $rr := $exists($reg) and $reg != null ? $reg : '';\n  $isDep := $contains($qq, /^([0-9]{2,3}|2[ab])$/);\n  $f := $input[($rr = '' or rg = $rr) and ($qq = '' or ($isDep ? $lowercase(d) = $qq : $contains(s, $qq)))]; {'data': $append([], $f[lat != null].{'id': i, 'lat': lat, 'lon': lon, 'label': n})} )"
        }
       },
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "bitd",
         "formDataProvider": "filtres",
         "outputProvider": "compte",
         "expression": "( $qq := $lowercase($trim($string($exists($q) ? $q : '')));\n  $rr := $exists($reg) and $reg != null ? $reg : '';\n  $isDep := $contains($qq, /^([0-9]{2,3}|2[ab])$/);\n  $f := $input[($rr = '' or rg = $rr) and ($qq = '' or ($isDep ? $lowercase(d) = $qq : $contains(s, $qq)))]; $n := $count($f); {'txt': $string($n) & ' entreprise' & ($n > 1 ? 's' : '') & ($n > 150 ? ' (150 premières listées)' : '') & ' · ' & $string($count($f[lat != null])) & ' sur la carte'} )"
        }
       },
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "bitd",
         "formDataProvider": "etat",
         "outputProvider": "fiche",
         "expression": "( $e := $input[i = $sel]; $exists($e) ? $e : {} )"
        }
       },
       {
        "tagName": "sonic-jsonata",
        "attributes": {
         "inputProvider": "bitd",
         "formDataProvider": "etat",
         "outputProvider": "vue",
         "expression": "( $e := $input[i = $sel]; $exists($e) and $e.lat != null ? {'center': [$e.lon, $e.lat], 'zoom': 10, 'mode': 'fly', 'duration': 800, 'seq': $seq, 'selectedId': $sel} : {'fit': 'points', 'mode': 'ease', 'duration': 600, 'seq': $seq, 'selectedId': null} )"
        }
       },
       {
        "tagName": "h1",
        "textContent": "Membres du GICAT par territoire",
        "attributes": {
         "style": "font-size:1.5rem;font-weight:600;margin:0"
        }
       },
       {
        "tagName": "p",
        "textContent": "Annuaire GICAT 2026, informations déclarées par les sociétés. Position = centre de la commune (34 entreprises sans position). Une adhésion au GICAT ne suffit pas à classer une entreprise dans la BITD.",
        "attributes": {
         "style": "font-size:.875rem;opacity:.7;margin:0"
        }
       },
       {
        "tagName": "div",
        "attributes": {
         "style": "display:grid;gap:.5rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));align-items:end"
        },
        "nodes": [
         {
          "tagName": "sonic-input",
          "attributes": {
           "name": "q",
           "formDataProvider": "filtres",
           "label": "Recherche",
           "placeholder": "Nom, ville, 37, 2A, drone, cyber…"
          }
         },
         {
          "tagName": "sonic-select",
          "attributes": {
           "name": "reg",
           "formDataProvider": "filtres",
           "label": "Région",
           "options": "[{\"value\":\"\",\"wording\":\"Toutes les régions\"},{\"value\":\"Auvergne-Rhône-Alpes\",\"wording\":\"Auvergne-Rhône-Alpes\"},{\"value\":\"Bourgogne-Franche-Comté\",\"wording\":\"Bourgogne-Franche-Comté\"},{\"value\":\"Bretagne\",\"wording\":\"Bretagne\"},{\"value\":\"Centre-Val de Loire\",\"wording\":\"Centre-Val de Loire\"},{\"value\":\"Corse\",\"wording\":\"Corse\"},{\"value\":\"Grand Est\",\"wording\":\"Grand Est\"},{\"value\":\"Hauts-de-France\",\"wording\":\"Hauts-de-France\"},{\"value\":\"Île-de-France\",\"wording\":\"Île-de-France\"},{\"value\":\"Normandie\",\"wording\":\"Normandie\"},{\"value\":\"Nouvelle-Aquitaine\",\"wording\":\"Nouvelle-Aquitaine\"},{\"value\":\"Occitanie\",\"wording\":\"Occitanie\"},{\"value\":\"Pays de la Loire\",\"wording\":\"Pays de la Loire\"},{\"value\":\"Provence-Alpes-Côte d'Azur\",\"wording\":\"Provence-Alpes-Côte d'Azur\"}]"
          }
         },
         {
          "tagName": "sonic-action",
          "attributes": {
           "target": "etat",
           "type": "fit"
          },
          "nodes": [
           {
            "tagName": "sonic-button",
            "attributes": {
             "type": "default",
             "variant": "outline"
            },
            "nodes": [
             {
              "tagName": "span",
              "textContent": "Recadrer la carte"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "tagName": "p",
        "attributes": {
         "style": "font-size:.875rem;margin:0"
        },
        "nodes": [
         {
          "tagName": "sonic-value",
          "attributes": {
           "dataProvider": "compte",
           "key": "txt"
          }
         }
        ]
       },
       {
        "tagName": "div",
        "attributes": {
         "style": "display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));align-items:start"
        },
        "nodes": [
         {
          "tagName": "div",
          "attributes": {
           "style": "display:grid;gap:.75rem;align-content:start"
          },
          "nodes": [
           {
            "tagName": "sonic-if",
            "attributes": {
             "dataProvider": "etat",
             "key": "detOn",
             "equals": "true"
            },
            "nodes": [
             {
              "tagName": "sonic-card",
              "nodes": [
               {
                "tagName": "div",
                "attributes": {
                 "style": "display:grid;gap:.5rem;padding:1rem"
                },
                "nodes": [
                 {
                  "tagName": "h2",
                  "attributes": {
                   "style": "font-size:1.125rem;font-weight:600;margin:0"
                  },
                  "nodes": [
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "n"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Adresse",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "a"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Commune",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "v"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Département",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "dn"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Région",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "rg"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Téléphone",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "t"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Site",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "w"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Effectif",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "f"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "div",
                  "attributes": {
                   "style": "display:flex;gap:.5rem;font-size:.875rem"
                  },
                  "nodes": [
                   {
                    "tagName": "span",
                    "textContent": "Domaines",
                    "attributes": {
                     "style": "opacity:.7;width:7rem;flex-shrink:0"
                    }
                   },
                   {
                    "tagName": "sonic-value",
                    "attributes": {
                     "dataProvider": "fiche",
                     "key": "dm"
                    }
                   }
                  ]
                 },
                 {
                  "tagName": "sonic-subscriber",
                  "attributes": {
                   "dataProvider": "fiche"
                  },
                  "nodes": [
                   {
                    "tagName": "div",
                    "attributes": {
                     "style": "display:flex;gap:.75rem;padding-top:.5rem"
                    },
                    "nodes": [
                     {
                      "tagName": "a",
                      "attributes": {
                       "data-bind": "",
                       "::href": "https://www.google.com/maps/search/?api=1&query=$mq",
                       "target": "_blank",
                       "rel": "noopener noreferrer",
                       "style": "text-decoration:underline"
                      },
                      "textContent": "Ouvrir dans Google Maps"
                     }
                    ]
                   }
                  ]
                 },
                 {
                  "tagName": "sonic-action",
                  "attributes": {
                   "target": "etat",
                   "type": "close"
                  },
                  "nodes": [
                   {
                    "tagName": "sonic-button",
                    "attributes": {
                     "type": "default",
                     "variant": "ghost",
                     "size": "sm"
                    },
                    "nodes": [
                     {
                      "tagName": "span",
                      "textContent": "Fermer la fiche"
                     }
                    ]
                   }
                  ]
                 }
                ]
               }
              ]
             }
            ]
           },
           {
            "tagName": "div",
            "attributes": {
             "style": "display:grid;gap:.25rem;max-height:60vh;overflow:auto"
            },
            "nodes": [
             {
              "tagName": "sonic-list",
              "attributes": {
               "dataProvider": "liste"
              },
              "nodes": [
               {
                "tagName": "template",
                "nodes": [
                 {
                  "tagName": "sonic-action",
                  "attributes": {
                   "target": "etat",
                   "type": "select",
                   "data-bind": "",
                   "::payload": "$i"
                  },
                  "nodes": [
                   {
                    "tagName": "div",
                    "attributes": {
                     "class": "ligne",
                     "style": "display:grid;cursor:pointer;border-radius:6px;padding:.4rem .75rem;border-bottom:1px solid var(--sc-base-200, #e5e5e5)"
                    },
                    "nodes": [
                     {
                      "tagName": "strong",
                      "nodes": [
                       {
                        "tagName": "sonic-value",
                        "attributes": {
                         "key": "n"
                        }
                       }
                      ]
                     },
                     {
                      "tagName": "span",
                      "attributes": {
                       "style": "font-size:.875rem;opacity:.7",
                       "data-bind": "",
                       "::text-content": "$v · $dn ($d) · $rg"
                      }
                     }
                    ]
                   }
                  ]
                 }
                ]
               },
               {
                "tagName": "template",
                "attributes": {
                 "data-value": "no-item"
                },
                "nodes": [
                 {
                  "tagName": "p",
                  "textContent": "Aucune entreprise ne correspond. Élargissez la recherche.",
                  "attributes": {
                   "style": "font-size:.875rem;opacity:.7;padding:.75rem"
                  }
                 }
                ]
               }
              ]
             }
            ]
           }
          ]
         },
         {
          "tagName": "sonic-map",
          "attributes": {
           "points-provider": "pts",
           "view-provider": "vue",
           "style-provider": "fond",
           "state-provider": "carteEtat",
           "target": "etat",
           "pick-action-type": "select",
           "auto-select": true,
           "allowed-hosts": "tiles.openfreemap.org",
           "style": "display:block;height:min(70vh,640px);border-radius:8px;overflow:hidden"
          }
         }
        ]
       }
      ]
     }
    ]
   }
  }
 ]
}