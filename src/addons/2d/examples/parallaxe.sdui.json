    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "jeu",
      "initial": "{\"taps\": 0, \"camera\": {\"x\": 400, \"y\": 225, \"zoom\": 1, \"ease\": {\"ms\": 700, \"curve\": \"inOut\"}}, \"input\": {\"b1\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b2\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b3\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b4\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}}}",
      "reducer": "(\n  $p := $action.payload;\n  $o := $p.objectId ? $lookup($state.input, $p.objectId) : undefined;\n  $cam := function($s, $c) { $merge([$s, {\"camera\": $merge([$s.camera, $c])}]) };\n  $action.type = \"pick\" and $o ? $merge([$state, {\n    \"taps\": $state.taps + 1,\n    \"input\": $merge([$state.input, {$p.objectId: {\"impulse\": {\n      \"n\": $o.impulse.n + 1, \"x\": (($o.impulse.n * 7 + $state.taps) % 9 - 4) * 25, \"y\": -260\n    }}}])\n  }]) :\n  $action.type = \"pick\" ? $cam($state, {\"x\": $max([400, $min([1200, $p.x])])}) :\n  $action.type = \"zoom\" ? $cam($state, {\"zoom\": $max([0.5, $min([2, $state.camera.zoom * $p.k])])}) :\n  $state\n)"
     }
    },
