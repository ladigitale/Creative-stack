    {
      "id": "formes",
      "kind": "shader",
      "file": "formes.glsl",
      "version": 3,
      "license": "MIT",
      "title": "Formes génératives",
      "description": "Image fixe en aplats nets de 2 à 6 couleurs très distinctes sur fond noir, à vectoriser (sonic-vectorize) puis importer dans sonic-sketch (import-skip=\"#000000\", import-colors-from pour recolorer selon la palette ; ou iChannel1 = bande de couleurs pour dessiner directement aux couleurs de la palette) : cellules, courbes de niveau, rosace, entrelacs, taches, rayures ondulées, spirale, écailles, labyrinthe, bouquet, triangles, damier ondulé, ondes.",
      "tags": [
        "génératif",
        "formes",
        "vectorisation",
        "motif"
      ],
      "channels": [
        "iChannel1 : bande de couleurs facultative (une colonne par couleur de la palette)"
      ],
      "params": [
        {
          "name": "uParam0",
          "label": "Motif (0 cellules … 12 ondes)",
          "min": 0,
          "max": 12,
          "default": 0
        },
        {
          "name": "uParam1",
          "label": "Graine",
          "min": 0,
          "max": 999,
          "default": 1
        },
        {
          "name": "uParam2",
          "label": "Densité",
          "min": 1,
          "max": 10,
          "default": 3
        },
        {
          "name": "uParam3",
          "label": "Couleurs",
          "min": 2,
          "max": 6,
          "default": 4
        }
      ]
