0, 70, 0], \"clip\": \"marche\"}, {\"model\": \"ballon\", \"name\": \"b\", \"at\": [0.6, 0.11, 3]}]}, \"nodes\": {}, \"n\": 0}",
      "reducer": "(\n  $p := $action.payload;\n  $clips := [\"saut\", \"joie\", \"tir\", \"tacle\", \"chute\", \"course\", \"marche\"];\n  $action.type = \"pick\" and $p.objectId ? (\n    $n := $state.n + 1;\n    $merge([$state, {\"n\": $n, \"nodes\": $merge([$state.nodes, {$p.objectId: {\"clip\": $p.objectId = \"c0\" ? ($n % 2 = 1 ? \"assis\" : \"marche\") : $clips[$n % 7]}}])}])\n  ) :\n  $action.type = \"tous\" ? $merge([$state, {\"nodes\": $merge([$state.nodes, {\"p0\": {\"clip\": $p.clip}, \"p1\": {\"clip\": $p.clip}, \"p2\": {\"clip\": $p.clip}}])}]) :\n  $action.type = \"vue\" ? $merge([$state, {\"monde\": $merge([$state.monde, {\"view2d\": $p}])}]) :\n  $state\n)"
     }
