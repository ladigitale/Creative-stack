      "src": "assets/clip.webm",
      "loop": "",
      "hidden-preview": "",
      "audio-out": "master",
      "control": "clipCtl.player"
     }
    },
    {
     "tagName": "sonic-audio-analyser",
     "attributes": {
      "id": "spectre",
      "source": "#clip",
      "bands": "8"
     }
