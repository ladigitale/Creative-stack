    {
     "tagName": "div",
     "attributes": {
      "style": "position:relative;border-radius:.8rem;overflow:hidden;background:#0b0d14;aspect-ratio:16/9"
     },
     "nodes": [
      {
       "tagName": "sonic-shader",
       "attributes": {
        "id": "viz",
        "channel0": "#clip",
        "channel1": "#spectre",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  float bass = texture(iChannel1, vec2(0.02, 0.25)).r;\n  float mid = texture(iChannel1, vec2(0.12, 0.25)).r;\n  float kick = smoothstep(0.55, 0.95, bass);\n  vec2 q = (uv - 0.5) / (1.0 + 0.08 * kick) + 0.5;\n  float split = 0.004 + 0.02 * kick;\n  vec3 col;\n  col.r = texture(iChannel0, q + vec2(split, 0.0)).r;\n  col.g = texture(iChannel0, q).g;\n  col.b = texture(iChannel0, q - vec2(split, 0.0)).b;\n  col *= 0.85 + 0.35 * kick;\n  float x = pow(uv.x, 1.5) * 0.35;\n  float s = texture(iChannel1, vec2(x, 0.25)).r;\n  float bar = step(uv.y, s * 0.25) * step(0.5, fract(uv.x * 64.0));\n  col = mix(col, vec3(1.0, 0.95, 0.7), bar * 0.7);\n  float w = texture(iChannel1, vec2(uv.x, 0.75)).r - 0.5;\n  col += smoothstep(0.006, 0.0, abs(uv.y - 0.9 - w * 0.12)) * vec3(0.6, 0.9, 1.0) * (0.4 + mid);\n  c = vec4(col, 1.0);\n}",
        "style": "display:block;width:100%;height:100%"
       }
      },
