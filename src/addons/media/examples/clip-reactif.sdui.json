{
 "nodes": [
  {
   "tagName": "div",
   "attributes": {
    "style": "display:flex;flex-direction:column;gap:.7rem;max-width:34rem;margin:1rem auto;padding:0 1rem"
   },
   "nodes": [
    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "clipCtl",
      "initial": "{\"player\": {\"playing\": true, \"rate\": 1, \"seek\": {\"t\": 0, \"n\": 0}, \"loopStart\": 0, \"loopEnd\": 0}}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $p := $s.player;\n  $t = \"toggle\" ? $merge([$s, {\"player\": $merge([$p, {\"playing\": $not($p.playing)}])}]) :\n  $t = \"rate\" ? $merge([$s, {\"player\": $merge([$p, {\"rate\": $action.payload}])}]) :\n  $t = \"restart\" ? $merge([$s, {\"player\": $merge([$p, {\"seek\": {\"t\": 0, \"n\": $p.seek.n + 1}, \"playing\": true}])}]) :\n  $t = \"loop\" ? $merge([$s, {\"player\": $merge([$p, $p.loopEnd > 0 ? {\"loopStart\": 0, \"loopEnd\": 0} : {\"loopStart\": 2, \"loopEnd\": 4}])}]) :\n  $s\n)"
     }
    },
    {
     "tagName": "h1",
     "attributes": {
      "class": "text-xl font-bold m-0"
     },
     "nodes": [
