{
  "nodes": [
    {
      "tagName": "div",
      "attributes": {
        "style": "display:flex;flex-direction:column;gap:.8rem;max-width:34rem;margin:0 auto;padding:.8rem"
      },
      "nodes": [
        {
          "tagName": "sonic-store",
          "attributes": {
            "id": "ui",
            "initial": "{\"onglet\": \"poser\"}",
            "reducer": "$state"
          }
        },
        {
          "tagName": "sonic-store",
          "attributes": {
            "id": "brouillon",
            "initial": "{\"message\": \"Ici, quelqu'un a pensé à toi.\", \"effet\": \"message\"}",
            "reducer": "$state"
          }
        },
        {
          "tagName": "sonic-store",
          "attributes": {
            "id": "balises",
            "initial": "{\"items\": []}",
            "persist": "balises",
            "max-state-bytes": "1200000",
            "reducer": "$action.type = \"save\" ? $merge([$state, {\"items\": $append($state.items, [$action.payload])}]) : $action.type = \"remove\" ? $merge([$state, {\"items\": [$state.items[id != $action.payload]]}]) : $state"
          }
        },
        {
          "tagName": "sonic-orientation",
          "attributes": {
            "id": "orient",
            "for": "go",
            "sensors": true,
            "smoothing": "0.6",
            "rate": "15"
          }
        },
        {
          "tagName": "sonic-geolocation",
          "attributes": {
            "id": "geo",
            "for": "go",
            "places": "balises.items",
            "radius": "150"
          }
        },
        {
          "tagName": "sonic-image-embedder",
          "attributes": {
            "id": "emb",
            "for": "cam",
            "fps": "2"
          }
        },
        {
          "tagName": "h1",
          "attributes": {
            "style": "margin:0;font-size:1.4rem"
          },
          "textContent": "Balises"
        },
        {
          "tagName": "p",
          "textContent": "Pose une balise sur une surface plane et texturée (façade, panneau, vitrine), puis reviens la retrouver : son contenu s'y accroche.",
          "attributes": {
            "style": "margin:0;opacity:.75"
          }
        },
        {
          "tagName": "div",
          "attributes": {
            "style": "position:relative;aspect-ratio:3/4;border-radius:1rem;overflow:hidden;background:#0b0d14"
          },
          "nodes": [
            {
              "tagName": "sonic-camera",
              "attributes": {
                "id": "cam",
                "facing": "environment",
                "fit": "cover",
                "max-width": "960",
                "style": "position:absolute;inset:0;width:100%;height:100%"
              }
            },
            {
              "tagName": "sonic-anchor",
              "attributes": {
                "id": "ancre",
                "source": "#cam",
                "reference": "balises.items",
                "within": "geoState",
                "embedding": "emb",
                "gravity": "orientState",
                "active": true,
                "debug": true,
                "fit": "cover"
              }
            },
            {
              "tagName": "sonic-anchor-view",
              "attributes": {
                "anchor": "ancreState",
                "fit": "cover",
                "content-width": "800",
                "content-height": "600"
              },
              "nodes": [
                {
                  "tagName": "sonic-states",
                  "attributes": {
                    "dataProvider": "ancreState",
                    "data-path": "item.effet"
                  },
                  "nodes": [
                    {
                      "tagName": "template",
                      "attributes": {
                        "data-value": "^motif$"
                      },
                      "nodes": [
                        {
                          "tagName": "sonic-shader",
                          "attributes": {
                            "image": "void mainImage(out vec4 o, in vec2 f){\n  vec2 uv = f / iResolution.xy;\n  vec2 p = (uv - 0.5) * vec2(iResolution.x / iResolution.y, 1.0);\n  float t = iTime * 0.6;\n  float r = length(p);\n  float a = atan(p.y, p.x);\n  float w = sin(r * 22.0 - t * 4.0 + sin(a * 5.0 + t) * 1.5);\n  vec3 c1 = vec3(1.0, 0.36, 0.62), c2 = vec3(0.2, 0.95, 0.8), c3 = vec3(1.0, 0.86, 0.2);\n  vec3 col = mix(c1, c2, smoothstep(-0.6, 0.6, w));\n  col = mix(col, c3, smoothstep(0.85, 1.0, sin(a * 3.0 - t * 2.0)) * 0.6);\n  float edge = smoothstep(0.0, 0.02, min(min(uv.x, 1.0 - uv.x), min(uv.y, 1.0 - uv.y)));\n  o = vec4(col, 0.82 * edge);\n}",
                            "style": "display:block;width:100%;height:100%"
                          }
                        }
                      ]
                    },
                    {
                      "tagName": "template",
                      "attributes": {
                        "data-value": "^message$"
                      },
                      "nodes": [
                        {
                          "tagName": "div",
                          "attributes": {
                            "style": "width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:48px;box-sizing:border-box;background:rgba(255,236,92,.9);color:#111;font:700 64px/1.1 system-ui,sans-serif;text-align:center;border-radius:24px"
                          },
                          "nodes": [
                            {
                              "tagName": "sonic-value",
                              "attributes": {
                                "dataProvider": "ancreState",
                                "key": "item.message"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "div",
              "attributes": {
                "style": "position:absolute;left:0;right:0;bottom:1rem;display:flex;justify-content:center"
              },
              "nodes": [
                {
                  "tagName": "sonic-media-start",
                  "attributes": {
                    "id": "go",
                    "for": "cam",
                    "label": "Démarrer la caméra et les capteurs"
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "style": "display:flex;gap:.8rem;flex-wrap:wrap;font-size:.8rem;opacity:.75"
          },
          "nodes": [
            {
              "tagName": "span",
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "État : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "ancreState",
                    "key": "status"
                  }
                }
              ]
            },
            {
              "tagName": "span",
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "Points sûrs : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "ancreState",
                    "key": "inliers"
                  }
                }
              ]
            },
            {
              "tagName": "span",
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "Analyses/s : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "ancreState",
                    "key": "fps"
                  }
                }
              ]
            },
            {
              "tagName": "span",
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "Candidates : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "ancreState",
                    "key": "candidates"
                  }
                }
              ]
            },
            {
              "tagName": "span",
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "GPS ± m : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "geoState",
                    "key": "accuracy"
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "sonic-group",
          "attributes": {
            "formDataProvider": "ui"
          },
          "nodes": [
            {
              "tagName": "sonic-button",
              "attributes": {
                "radio": true,
                "name": "onglet",
                "value": "poser",
                "size": "sm",
                "variant": "outline"
              },
              "textContent": "Poser"
            },
            {
              "tagName": "sonic-button",
              "attributes": {
                "radio": true,
                "name": "onglet",
                "value": "liste",
                "size": "sm",
                "variant": "outline"
              },
              "textContent": "Mes balises"
            }
          ]
        },
        {
          "tagName": "sonic-if",
          "attributes": {
            "dataProvider": "ui",
            "key": "onglet",
            "equals": "poser"
          },
          "nodes": [
            {
              "tagName": "div",
              "attributes": {
                "style": "display:flex;flex-direction:column;gap:.6rem"
              },
              "nodes": [
                {
                  "tagName": "sonic-button",
                  "attributes": {
                    "id": "photo",
                    "type": "primary"
                  },
                  "textContent": "1. Photographier la surface"
                },
                {
                  "tagName": "sonic-anchor-ref",
                  "attributes": {
                    "id": "pose",
                    "source": "#cam",
                    "for": "photo",
                    "save-for": "garder",
                    "target": "balises",
                    "extra": "brouillon",
                    "gravity": "orientState",
                    "geo": "geoState",
                    "embedding": "emb",
                    "style": "border-radius:.8rem;overflow:hidden"
                  }
                },
                {
                  "tagName": "div",
                  "attributes": {
                    "style": "display:flex;gap:1rem;flex-wrap:wrap;font-size:.85rem;opacity:.8"
                  },
                  "nodes": [
                    {
                      "tagName": "span",
                      "nodes": [
                        {
                          "tagName": "span",
                          "textContent": "Points : "
                        },
                        {
                          "tagName": "sonic-value",
                          "attributes": {
                            "dataProvider": "poseState",
                            "key": "points"
                          }
                        }
                      ]
                    },
                    {
                      "tagName": "span",
                      "nodes": [
                        {
                          "tagName": "span",
                          "textContent": "Qualité : "
                        },
                        {
                          "tagName": "sonic-value",
                          "attributes": {
                            "dataProvider": "poseState",
                            "key": "quality"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "small",
                  "attributes": {
                    "style": "color:var(--sc-danger, #c33)"
                  },
                  "nodes": [
                    {
                      "tagName": "sonic-value",
                      "attributes": {
                        "dataProvider": "poseState",
                        "key": "error"
                      }
                    }
                  ]
                },
                {
                  "tagName": "small",
                  "textContent": "2. Place les quatre coins sur la surface : les points jaunes sont ce que la balise reconnaîtra, il en faut beaucoup et bien répartis.",
                  "attributes": {
                    "style": "opacity:.7"
                  }
                },
                {
                  "tagName": "sonic-fieldset",
                  "attributes": {
                    "label": "3. Contenu de la balise"
                  },
                  "nodes": [
                    {
                      "tagName": "sonic-form-layout",
                      "nodes": [
                        {
                          "tagName": "sonic-group",
                          "attributes": {
                            "formDataProvider": "brouillon"
                          },
                          "nodes": [
                            {
                              "tagName": "sonic-button",
                              "attributes": {
                                "radio": true,
                                "name": "effet",
                                "value": "message",
                                "size": "sm",
                                "variant": "outline"
                              },
                              "textContent": "Message"
                            },
                            {
                              "tagName": "sonic-button",
                              "attributes": {
                                "radio": true,
                                "name": "effet",
                                "value": "motif",
                                "size": "sm",
                                "variant": "outline"
                              },
                              "textContent": "Motif animé"
                            }
                          ]
                        },
                        {
                          "tagName": "sonic-input",
                          "attributes": {
                            "formDataProvider": "brouillon",
                            "name": "message",
                            "label": "Message accroché à la surface"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "sonic-button",
                  "attributes": {
                    "id": "garder",
                    "type": "success"
                  },
                  "textContent": "4. Poser la balise ici"
                },
                {
                  "tagName": "small",
                  "attributes": {
                    "style": "opacity:.75"
                  },
                  "nodes": [
                    {
                      "tagName": "span",
                      "textContent": "Balises posées pendant cette visite : "
                    },
                    {
                      "tagName": "sonic-value",
                      "attributes": {
                        "dataProvider": "poseState",
                        "key": "saved"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "sonic-if",
          "attributes": {
            "dataProvider": "ui",
            "key": "onglet",
            "equals": "liste"
          },
          "nodes": [
            {
              "tagName": "sonic-jsonata",
              "attributes": {
                "inputProvider": "balises",
                "outputProvider": "listeBalises",
                "expression": "$append([], $reverse($input.items).{\"id\": id, \"message\": message, \"effet\": effet, \"points\": points, \"quand\": $substring(createdAt, 0, 16), \"gps\": lat ? \"GPS ± \" & $string($round(accuracy)) & \" m\" : \"sans GPS\"})"
              }
            },
            {
              "tagName": "sonic-list",
              "attributes": {
                "dataProvider": "listeBalises"
              },
              "nodes": [
                {
                  "tagName": "template",
                  "nodes": [
                    {
                      "tagName": "div",
                      "attributes": {
                        "style": "display:flex;gap:.6rem;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--sc-base-200, #ddd)"
                      },
                      "nodes": [
                        {
                          "tagName": "div",
                          "attributes": {
                            "style": "flex:1;min-width:0"
                          },
                          "nodes": [
                            {
                              "tagName": "strong",
                              "attributes": {
                                "style": "display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                              },
                              "nodes": [
                                {
                                  "tagName": "sonic-value",
                                  "attributes": {
                                    "key": "message"
                                  }
                                }
                              ]
                            },
                            {
                              "tagName": "small",
                              "attributes": {
                                "data-bind": "",
                                "::text-content": "$quand · $effet · $points points · $gps",
                                "style": "opacity:.7"
                              }
                            }
                          ]
                        },
                        {
                          "tagName": "sonic-action",
                          "attributes": {
                            "target": "balises",
                            "type": "remove",
                            "data-bind": "",
                            "::payload": "$id"
                          },
                          "nodes": [
                            {
                              "tagName": "sonic-button",
                              "attributes": {
                                "type": "danger",
                                "variant": "ghost",
                                "size": "sm"
                              },
                              "textContent": "Supprimer"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "tagName": "template",
                  "attributes": {
                    "data-value": "no-item"
                  },
                  "nodes": [
                    {
                      "tagName": "p",
                      "textContent": "Aucune balise pour l'instant : pose la première dans l'onglet « Poser ».",
                      "attributes": {
                        "style": "opacity:.7"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "small",
              "attributes": {
                "style": "opacity:.75"
              },
              "nodes": [
                {
                  "tagName": "span",
                  "textContent": "Sauvegarde : "
                },
                {
                  "tagName": "sonic-value",
                  "attributes": {
                    "dataProvider": "sauvegarde",
                    "key": "etat"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
