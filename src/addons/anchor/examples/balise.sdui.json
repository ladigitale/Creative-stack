                                          "tagName": "div",
                                          "attributes": {
                                            "style": "width:100%;height:100%;display:flex;align-items:center;justify-content:center;padding:48px;box-sizing:border-box;background:rgba(255,236,92,.9);color:#111;font:700 64px/1.1 system-ui,sans-serif;text-align:center;border-radius:24px"
                                          },
                                          "nodes": [
                                            {
                                              "tagName": "sonic-value",
                                              "attributes": {
                                                "dataProvider": "ancreState",
                                                "key": "item.message"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
