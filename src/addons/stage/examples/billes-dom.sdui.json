      "initial": "{\"taps\": 0, \"input\": {\"b1\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b2\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b3\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}, \"b4\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}}}}",
      "reducer": "(\n  $p := $action.payload;\n  $o := $p.objectId ? $lookup($state.input, $p.objectId) : undefined;\n  $action.type = \"pick\" and $o ? $merge([$state, {\n    \"taps\": $state.taps + 1,\n    \"input\": $merge([$state.input, {$p.objectId: {\"impulse\": {\n      \"n\": $o.impulse.n + 1,\n      \"x\": (($o.impulse.n * 7 + $state.taps) % 9 - 4) * 25,\n      \"y\": -260\n    }}}])\n  }]) : $state\n)"
     }
    },
    {
     "tagName": "p",
     "attributes": {
      "style": "margin:0"
     },
     "textContent": "Touche une bille : elle saute. Les billes et la carte sont des éléments HTML placés par la physique, sans canvas visible."
