      "reducer": "(\n  $a := $action.type; $p := $action.payload;\n  $a = \"scene\" ? $merge([$state, {\"scene\": $p.scene, \"seed\": $p.seed ? $p.seed : $state.seed}]) :\n  $a = \"seed\" ? $merge([$state, {\"seed\": $string($state.seedN + 1), \"seedN\": $state.seedN + 1}]) :\n  $a = \"style\" ? $merge([$state, {\"style\": $p.style}]) :\n  $a = \"play\" ? $merge([$state, {\"anim\": {\"play\": $not($state.anim.play), \"speed\": $state.anim.speed}}]) :\n  $a = \"speed\" ? $merge([$state, {\"anim\": {\"play\": $state.anim.play, \"speed\": $p.v}}]) :\n  $a = \"select\" ? $merge([$state, {\"picked\": $p.objectId ? $p.objectId : \"(rien)\"}]) :\n  $state\n)"
