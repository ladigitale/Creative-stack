      "effect": "blur",
      "amount": "0.6",
      "feather": "0.3",
      "smooth": "0.4",
      "out-data-provider": "replaceState",
      "style": "border-radius:.8rem;overflow:hidden;background:#0b0d14"
     }
    },
    {
     "tagName": "div",
     "attributes": {
      "style": "display:flex;gap:.6rem;align-items:center;flex-wrap:wrap"
