       }
      },
      {
       "tagName": "span",
       "textContent": " · mode "
      },
      {
       "tagName": "sonic-value",
       "attributes": {
        "dataProvider": "meshState",
        "key": "mode"
       }
      }
     ]
    }
   ]
  }
 ]
