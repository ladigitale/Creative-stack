{
 "nodes": [
  {
   "tagName": "div",
   "attributes": {
    "style": "display:flex;flex-direction:column;gap:.7rem;max-width:44rem;margin:1rem auto;padding:0 1rem"
   },
   "nodes": [
    {
     "tagName": "h1",
     "attributes": {
      "class": "text-xl font-bold m-0"
     },
     "nodes": [
      {
       "tagName": "span",
       "textContent": "Recomposition : toi, ailleurs"
      }
     ]
    },
    {
     "tagName": "p",
     "attributes": {
      "style": "margin:0;opacity:.8"
     },
     "nodes": [
      {
       "tagName": "span",
       "textContent": "La personne est découpée (sonic-mask-replace, effect=cutout) puis placée comme un sprite dans une scène 2D, avec un décor en parallaxe. Une copie fantôme sert de reflet. Déplace-toi : la silhouette suit ; la caméra de la scène peut être pilotée par un sonic-store."
      }
     ]
    },
    {
     "tagName": "sonic-camera",
     "attributes": {
      "id": "cam",
      "facing": "user",
      "width": "640",
      "height": "480",
      "fps": "30",
      "mirror": "false",
      "hidden-preview": ""
     }
    },
    {
     "tagName": "sonic-segmenter",
     "attributes": {
      "id": "seg",
      "for": "cam",
      "mode": "alpha",
      "fps": "30",
      "smooth": "0.2",
      "mirror": "false"
     }
    },
    {
     "tagName": "sonic-frame-sync",
     "attributes": {
      "id": "synced",
      "for": "cam",
      "sync": "seg"
     }
    },
    {
     "tagName": "sonic-mask-replace",
     "attributes": {
      "id": "personne",
      "source": "synced",
      "mask": "seg",
      "mirror": "true",
      "target": "background",
      "effect": "cutout",
      "feather": "0.25",
      "smooth": "0.3",
      "out-data-provider": "personneState",
      "style": "display:none"
     }
    },
    {
     "tagName": "sonic-2d",
     "attributes": {
      "width": "800",
      "height": "450",
      "background": "#0b1220",
      "layers": "ciel:0 montagnes:0.3 scene:1",
      "style": "border-radius:.8rem;overflow:hidden"
     },
     "nodes": [
      {
