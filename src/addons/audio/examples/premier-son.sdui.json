        },
        {
         "tagName": "sonic-env",
         "attributes": {
          "name": "aenv",
          "a": "0.01",
          "d": "0.3",
          "s": "0.6",
          "r": "0.5"
         }
        },
        {
         "tagName": "sonic-vca",
         "attributes": {
          "name": "amp",
          "in": "flt",
          "gain": "aenv"
