   "nodes": [
    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "piano",
      "initial": "{\"inst\": \"lead\", \"lead\": [], \"hand\": [], \"drums\": [], \"tickLead\": 0, \"tickHand\": 0, \"tickDrums\": 0, \"cutoff\": 900, \"last\": \"\"}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $scale := [\"C4\",\"D4\",\"E4\",\"G4\",\"A4\",\"C5\",\"D5\",\"E5\"];\n  $substring($t, 0, 1) = \"n\" and $length($t) = 2 ? (\n    $note := $scale[$number($substring($t, 1))];\n    $ev := [{\"note\": $note, \"vel\": 0.85}];\n    $merge([$s, {\n      \"lead\": $s.inst = \"lead\" ? $ev : $s.lead,\n      \"hand\": $s.inst = \"hand\" ? $ev : $s.hand,\n      \"tickLead\": $s.inst = \"lead\" ? $s.tickLead + 1 : $s.tickLead,\n      \"tickHand\": $s.inst = \"hand\" ? $s.tickHand + 1 : $s.tickHand,\n      \"last\": $note\n    }])\n  ) :\n  $substring($t, 0, 2) = \"d_\" ? $merge([$s, {\"drums\": [{\"sample\": $substring($t, 2), \"vel\": 0.9}], \"tickDrums\": $s.tickDrums + 1, \"last\": $substring($t, 2)}]) :\n  $t in [\"lead\", \"hand\"] ? $merge([$s, {\"inst\": $t}]) :\n  $t = \"brighter\" ? $merge([$s, {\"cutoff\": $min([$s.cutoff * 1.5, 8000])}]) :\n  $t = \"darker\" ? $merge([$s, {\"cutoff\": $max([$s.cutoff / 1.5, 150])}]) :\n  $s\n)",
      "budget-ms": "40"
     }
    },
    {
     "tagName": "sonic-keyboard",
     "attributes": {
      "target": "piano",
      "scope": "document",
      "keymap": "{\"KeyA\": \"n0\", \"KeyS\": \"n1\", \"KeyD\": \"n2\", \"KeyF\": \"n3\", \"KeyG\": \"n4\", \"KeyH\": \"n5\", \"KeyJ\": \"n6\", \"KeyK\": \"n7\", \"KeyZ\": \"d_kick\", \"KeyX\": \"d_snare\", \"KeyC\": \"d_hat\", \"KeyV\": \"d_clap\", \"Digit1\": \"lead\", \"Digit2\": \"hand\", \"ArrowUp\": \"brighter\", \"ArrowDown\": \"darker\"}"
     }
    },
