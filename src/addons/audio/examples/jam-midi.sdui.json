    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "jam",
      "initial": "{\"transport\": {\"playing\": false}, \"midi\": {\"output\": \"none\", \"panic\": 0}, \"clockOn\": false, \"notes\": [], \"tick\": 0, \"last\": \"\\u2014\"}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $p := $action.payload;\n  $scale := [\"C4\", \"D4\", \"E4\", \"G4\", \"A4\", \"C5\"];\n  $t = \"midi\" and $p.kind = \"noteOn\" ? $merge([$s, {\"last\": $p.name}]) :\n  $t = \"midi\" ? $s :\n  $t = \"pad\" ? $merge([$s, {\"notes\": [{\"note\": $scale[$p], \"vel\": 0.8, \"durS\": 0.6, \"timbre\": 0.3 + $p * 0.1}], \"tick\": $s.tick + 1, \"last\": $scale[$p]}]) :\n  $t = \"play\" ? $merge([$s, {\"transport\": {\"playing\": $not($s.transport.playing)}}]) :\n  $t = \"clock\" ? $merge([$s, {\"clockOn\": $not($s.clockOn), \"midi\": $merge([$s.midi, {\"output\": $s.clockOn ? \"none\" : \"all\"}])}]) :\n  $t = \"panic\" ? $merge([$s, {\"midi\": $merge([$s.midi, {\"panic\": $s.midi.panic + 1}])}]) :\n  $s\n)"
     }
    },
