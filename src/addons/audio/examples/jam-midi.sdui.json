      {
       "tagName": "sonic-shader",
       "attributes": {
        "id": "viz",
        "channel0": "#spectre",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  float s = texture(iChannel0, vec2(pow(uv.x, 1.5) * 0.5, 0.25)).r;\n  float w = texture(iChannel0, vec2(uv.x, 0.75)).r - 0.5;\n  float bars = smoothstep(s, s - 0.015, abs(uv.y - 0.5) * 2.6);\n  float line = smoothstep(0.012, 0.0, abs(uv.y - 0.5 - w * 0.7));\n  vec3 bg = mix(vec3(0.03, 0.03, 0.06), vec3(0.08, 0.03, 0.12), uv.y);\n  vec3 hue = 0.55 + 0.45 * cos(6.2831853 * (uv.x * 0.8 + vec3(0.0, 0.25, 0.5)) + iTime * 0.3);\n  c = vec4(bg + bars * hue * 0.8 + line * vec3(1.0, 0.9, 0.7), 1.0);\n}",
        "style": "display:block;width:100%;height:100%"
       }
