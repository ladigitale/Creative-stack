       "tagName": "sonic-shader",
       "attributes": {
        "id": "viz",
        "channel0": "#spectre",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  vec2 q = uv - 0.5; q.x *= iResolution.x / iResolution.y;\n  float s = texture(iChannel0, vec2(fract(atan(q.y, q.x) / 6.2831853 + 0.5) * 0.5, 0.25)).r;\n  float r = length(q);\n  float cloud = 0.0;\n  for (int i = 0; i < 5; i++) {\n    float fi = float(i);\n    vec2 o = vec2(sin(iTime * 0.21 * (fi + 1.0) + fi), cos(iTime * 0.17 * (fi + 1.3))) * 0.18;\n    cloud += 0.02 / (length(q - o) + 0.04);\n  }\n  vec3 col = vec3(0.03, 0.03, 0.07) + cloud * mix(vec3(0.3, 0.45, 1.0), vec3(1.0, 0.5, 0.8), s) * (0.25 + s) * 0.35;\n  col += smoothstep(0.01, 0.0, abs(r - 0.22 - s * 0.18)) * vec3(0.9, 0.8, 1.0) * 0.6;\n  c = vec4(col, 1.0);\n}",
        "style": "display:block;width:100%;height:100%"
       }
