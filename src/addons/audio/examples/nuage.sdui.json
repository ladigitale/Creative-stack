     "tagName": "sonic-store",
     "attributes": {
      "id": "nuage",
      "initial": "{\"src\": \"clip\", \"notes\": [], \"tick\": 0, \"rec\": {\"recording\": false, \"target\": \"takes.voix\"}, \"transport\": {\"playing\": false}, \"pos\": 0.4, \"size\": 0.09, \"dens\": 24, \"fold\": 1, \"cut\": 2600}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $p := $action.payload;\n  $clamp := function($v, $a, $b) { $v < $a ? $a : ($v > $b ? $b : $v) };\n  $r2 := function($v) { $round($v * 100) / 100 };\n  $t = \"note\" ? $merge([$s, {\"notes\": [$map($p, function($n) { {\"note\": $n, \"sample\": $s.src, \"durS\": 3, \"vel\": 0.8} })], \"tick\": $s.tick + 1}]) :\n  $t = \"src\" ? $merge([$s, {\"src\": $s.src = \"clip\" ? \"voix\" : \"clip\"}]) :\n  $t = \"rec\" ? $merge([$s, {\"rec\": {\"recording\": $not($s.rec.recording), \"target\": \"takes.voix\"}, \"src\": \"voix\"}]) :\n  $t = \"bass\" ? $merge([$s, {\"transport\": {\"playing\": $not($s.transport.playing)}}]) :\n  $t = \"pos\" ? $merge([$s, {\"pos\": $r2($clamp($s.pos + $p * 0.05, 0, 1))}]) :\n  $t = \"size\" ? $merge([$s, {\"size\": $r2($clamp($s.size * ($p > 0 ? 1.5 : 0.6667), 0.01, 1))}]) :\n  $t = \"dens\" ? $merge([$s, {\"dens\": $r2($clamp($s.dens * ($p > 0 ? 1.5 : 0.6667), 2, 120))}]) :\n  $t = \"fold\" ? $merge([$s, {\"fold\": $r2($clamp($s.fold + $p * 0.5, 0.5, 8))}]) :\n  $t = \"cut\" ? $merge([$s, {\"cut\": $round($clamp($s.cut * ($p > 0 ? 1.4 : 0.714), 200, 12000))}]) :\n  $s\n)"
     }
