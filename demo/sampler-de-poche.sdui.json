     "nodes": [
      {
       "tagName": "sonic-shader",
       "attributes": {
        "id": "viz",
        "channel0": "#spectre",
        "channel1": "#voixSpec",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  vec2 q = uv - 0.5; q.x *= iResolution.x / iResolution.y;\n  float r = length(q);\n  float a = atan(q.y, q.x);\n  float x = fract(a / 6.2831853 + 0.5);\n  float band = texture(iChannel0, vec2(pow(abs(x * 2.0 - 1.0), 1.4) * 0.5, 0.25)).r;\n  float wave = texture(iChannel1, vec2(uv.x, 0.75)).r - 0.5;\n  float ring = smoothstep(0.012, 0.0, abs(r - 0.18 - band * 0.22));\n  float glow = band * smoothstep(0.5, 0.0, r);\n  float line = smoothstep(0.01, 0.0, abs(uv.y - 0.5 - wave * 0.9)) * 0.8;\n  vec3 bg = mix(vec3(0.03, 0.04, 0.08), vec3(0.10, 0.05, 0.14), uv.y + 0.2 * sin(iTime * 0.3));\n  vec3 hue = 0.5 + 0.5 * cos(6.2831853 * (x + vec3(0.0, 0.33, 0.67)) + iTime * 0.4);\n  vec3 col = bg + ring * hue + glow * hue * 0.6 + line * vec3(1.0, 0.85, 0.5);\n  c = vec4(col, 1.0);\n}",
        "style": "display:block;width:100%;height:100%"
       }
      },
