    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "poche",
      "initial": "{\"armed\": \"A\", \"rec\": {\"recording\": false, \"target\": \"takes.A\"}, \"notes\": [], \"tick\": 0, \"transport\": {\"playing\": false}, \"export\": {\"recording\": false}}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $t = \"arm\" ? $merge([$s, {\"armed\": $action.payload, \"rec\": $merge([$s.rec, {\"target\": \"takes.\" & $action.payload}])}]) :\n  $t = \"rec\" ? $merge([$s, {\"rec\": $merge([$s.rec, {\"recording\": $not($s.rec.recording)}])}]) :\n  $t = \"hit\" ? $merge([$s, {\"notes\": [{\"sample\": $action.payload, \"vel\": 0.9}], \"tick\": $s.tick + 1}]) :\n  $t = \"play\" ? $merge([$s, {\"transport\": $merge([$s.transport, {\"playing\": $not($s.transport.playing)}])}]) :\n  $t = \"export\" ? $merge([$s, {\"export\": {\"recording\": $not($s.export.recording)}}]) :\n  $s\n)"
     }
    },
