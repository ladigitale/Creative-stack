      "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  float x = pow(uv.x, 1.6);\n  float s = texture(iChannel0, vec2(x * 0.5, 0.25)).r;\n  float w = texture(iChannel0, vec2(uv.x, 0.75)).r - 0.5;\n  float bar = smoothstep(s, s - 0.02, uv.y);\n  float line = smoothstep(0.012, 0.0, abs(uv.y - 0.5 - w * 0.8));\n  vec3 bg = mix(vec3(0.04, 0.05, 0.09), vec3(0.09, 0.06, 0.16), uv.y);\n  vec3 col = bg + bar * mix(vec3(0.13, 0.83, 0.93), vec3(0.98, 0.45, 0.85), uv.x) * 0.85 + line * vec3(1.0, 0.9, 0.6);\n  c = vec4(col, 1.0);\n}",
