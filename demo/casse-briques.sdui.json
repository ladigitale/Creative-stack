": \"brick\", \"row\": 4}, {\"name\": \"b-4-6\", \"type\": \"static\", \"shape\": \"box\", \"w\": 66, \"h\": 20, \"x\": 511, \"y\": 172, \"fill\": \"#38bdf8\", \"tags\": \"brick\", \"row\": 4}, {\"name\": \"b-4-7\", \"type\": \"static\", \"shape\": \"box\", \"w\": 66, \"h\": 20, \"x\": 585, \"y\": 172, \"fill\": \"#38bdf8\", \"tags\": \"brick\", \"row\": 4}, {\"name\": \"b-4-8\", \"type\": \"static\", \"shape\": \"box\", \"w\": 66, \"h\": 20, \"x\": 659, \"y\": 172, \"fill\": \"#38bdf8\", \"tags\": \"brick\", \"row\": 4}, {\"name\": \"b-4-9\", \"type\": \"static\", \"shape\": \"box\", \"w\": 66, \"h\": 20, \"x\": 733, \"y\": 172, \"fill\": \"#38bdf8\", \"tags\": \"brick\", \"row\": 4}], \"score\": 0, \"lives\": 3, \"state\": \"prêt\", \"input\": {\"paddle\": {\"vx\": 0, \"set\": {\"n\": 0, \"x\": 400, \"y\": 420}}, \"ball\": {\"impulse\": {\"n\": 0, \"x\": 0, \"y\": 0}, \"set\": {\"n\": 0, \"x\": 400, \"y\": 396}}}, \"notes\": [], \"tick\": 0, \"padCtl\": {\"rumble\": {\"n\": 0, \"ms\": 120}}}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $p := $action.payload;\n  $scale := [\"C6\", \"A5\", \"G5\", \"E5\", \"D5\"];\n  $vx := function($s, $v) { $merge([$s, {\"input\": $merge([$s.input, {\"paddle\": $merge([$s.input.paddle, {\"vx\": $v}])}])}]) };\n  $launch := function($s) {\n    $s.state = \"prêt\" ? $merge([$s, {\"state\": \"en jeu\", \"input\": $merge([$s.input, {\"ball\": $merge([$s.input.ball, {\"impulse\": {\"n\": $s.input.ball.impulse.n + 1, \"x\": (($s.lives * 7 + $count($s.bricks) + $s.input.ball.impulse.n) % 9 - 4) * 5, \"y\": -34}}])}])}]) : $s\n  };\n  $place := function($s, $state) {\n    $merge([$s, {\"state\": $state, \"input\": {\n      \"paddle\": {\"vx\": 0, \"set\": {\"n\": $s.input.paddle.set.n + 1, \"x\": 400, \"y\": 420}},\n      \"ball\": {\"impulse\": $s.input.ball.impulse, \"set\": {\"n\": $s.input.ball.set.n + 1, \"x\": 400, \"y\": 396}}\n    }}])\n  };\n  $t = \"left\" ? $vx($s, -650) :\n  $t = \"right\" ? $vx($s, 650) :\n  ($t = \"left:up\" and $s.input.paddle.vx < 0) or ($t = \"right:up\" and $s.input.paddle.vx > 0) ? $vx($s, 0) :\n  $t = \"stick\" ? $vx($s, $round($p.lx * 700)) :\n  $t = \"launch\" ? $launch($s) :\n  $t = \"tap\" ? (\n    $moved := $merge([$s, {\"input\": $merge([$s.input, {\"paddle\": $merge([$s.input.paddle, {\"set\": {\"n\": $s.input.paddle.set.n + 1, \"x\": $p.x, \"y\": 420}}])}])}]);\n    $s.state = \"prêt\" ? $launch($place($s, \"prêt\")) : $moved\n  ) :\n  $t = \"collide\" ? (\n    $brick := \"brick\" in $p.tagsA ? $p.a : (\"brick\" in $p.tagsB ? $p.b : \"\");\n    $paddle := \"paddle\" in $p.tagsA or \"paddle\" in $p.tagsB;\n    $brick != \"\" ? (\n      $hit := $s.bricks[name = $brick];\n      $left := [$s.bricks[name != $brick]];\n      $won := $count($left) = 0;\n      $next := $merge([$s, {\n        \"bricks\": $left, \"score\": $s.score + 10 * (5 - $hit.row),\n        \"notes\": [{\"note\": $scale[$hit.row], \"vel\": 0.85}], \"tick\": $s.tick + 1,\n        \"padCtl\": {\"rumble\": {\"n\": $s.padCtl.rumble.n + 1, \"ms\": 60}}\n      }]);\n      $won ? $place($next, \"gagné !\") : $next\n    ) :\n    $paddle ? $merge([$s, {\"notes\": [{\"note\": \"C4\", \"vel\": 0.5}], \"tick\": $s.tick + 1}]) : $s\n  ) :\n  $t = \"out\" and $p.body = \"ball\" and $s.state = \"en jeu\" ? (\n    $lives := $s.lives - 1;\n    $merge([$place($s, $lives <= 0 ? \"perdu\" : \"prêt\"), {\n      \"lives\": $lives, \"notes\": [{\"note\": \"C2\", \"durS\": 0.6, \"vel\": 0.9}], \"tick\": $s.tick + 1,\n      \"padCtl\": {\"rumble\": {\"n\": $s.padCtl.rumble.n + 1, \"ms\": 400}}\n    }])\n  ) :\n  $t = \"restart\" ? $merge([$place($s, \"prêt\"), {\"bricks\": $s.level, \"score\": 0, \"lives\": 3}]) :\n  $s\n)"
     }
