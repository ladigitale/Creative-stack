      "style": "position:relative;border-radius:.8rem;overflow:hidden;background:#0b0d14;aspect-ratio:16/9"
     },
     "nodes": [
      {
       "tagName": "sonic-shader",
       "attributes": {
        "id": "fx",
        "channel0": "#cam",
        "dataProvider": "miroir",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  int fx = int(uParam0 + 0.5);\n  if (fx == 1) {\n    vec2 q = uv - 0.5; q.x *= iResolution.x / iResolution.y;\n    float a = atan(q.y, q.x) + iTime * 0.15; float r = length(q); float n = 6.0;\n    a = mod(a, 6.2831853 / n); a = abs(a - 3.1415926 / n);\n    uv = 0.5 + r * vec2(cos(a) * iResolution.y / iResolution.x, sin(a));\n  }\n  if (fx == 3) { vec2 cells = vec2(64.0, 36.0); uv = (floor(uv * cells) + 0.5) / cells; }\n  vec3 col = texture(iChannel0, uv).rgb;\n  if (fx == 2) {\n    float l = dot(col, vec3(0.299, 0.587, 0.114));\n    col = clamp(vec3(1.6 * l - 0.3, sin(3.14159 * l) * 1.1, 1.0 - 1.8 * l), 0.0, 1.0);\n  }\n  if (fx == 3) {\n    vec2 f = fract(uv * vec2(64.0, 36.0)) - 0.5;\n    col *= smoothstep(0.5, 0.42, max(abs(f.x), abs(f.y)));\n  }\n  c = vec4(col, 1.0);\n}",
        "style": "display:block;width:100%;height:100%"
       }
      },
      {
       "tagName": "div",
       "attributes": {
        "style": "position:absolute;inset:0;display:flex;align-items:center;justify-content:center"
