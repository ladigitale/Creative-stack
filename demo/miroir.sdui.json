     "tagName": "sonic-camera",
     "attributes": {
      "id": "cam",
      "hidden-preview": "",
      "control": "miroir.cam",
      "snapshot-provider": "gallery.channel0",
      "width": "960",
      "height": "540",
      "max-width": "960"
     }
    },
    {
     "tagName": "div",
