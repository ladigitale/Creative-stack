    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "miroir",
      "initial": "{\"param0\": 0, \"fxName\": \"Normal\", \"cam\": {\"snapshot\": 0, \"facing\": \"user\"}}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $t = \"fx\" ? $merge([$s, {\"param0\": $action.payload, \"fxName\": [\"Normal\", \"Kaléidoscope\", \"Thermique\", \"Pixels\"][$action.payload]}]) :\n  $t = \"snap\" ? $merge([$s, {\"cam\": $merge([$s.cam, {\"snapshot\": $s.cam.snapshot + 1}])}]) :\n  $t = \"flip\" ? $merge([$s, {\"cam\": $merge([$s.cam, {\"facing\": $s.cam.facing = \"user\" ? \"environment\" : \"user\"}])}]) :\n  $s\n)"
     }
    },
