       "tagName": "sonic-shader",
       "attributes": {
        "id": "photo",
        "dataProvider": "gallery",
        "image": "void mainImage(out vec4 c, in vec2 p){\n  vec2 uv = p / iResolution.xy;\n  vec2 m = vec2(0.05, 0.08);\n  vec2 q = (uv - m) / (1.0 - 2.0 * m);\n  vec3 paper = vec3(0.96, 0.95, 0.92);\n  vec3 photo = texture(iChannel0, q).rgb;\n  bool inside = all(greaterThan(q, vec2(0.0))) && all(lessThan(q, vec2(1.0)));\n  float has = step(0.5, iChannelResolution[0].x);\n  vec3 empty = vec3(0.12, 0.13, 0.18);\n  c = vec4(inside ? mix(empty, photo, has) : paper, 1.0);\n}",
        "style": "display:block;width:100%;aspect-ratio:4/3;border-radius:.4rem;overflow:hidden"
       }
