    {
     "tagName": "sonic-store",
     "attributes": {
      "id": "game",
      "initial": "{\"score\": 0, \"combo\": 0, \"sound\": {\"music\": null, \"muted\": false, \"paused\": false, \"fade\": 0.8, \"play\": {\"coin\": {\"n\": 0}, \"jump\": {\"n\": 0}, \"hit\": {\"n\": 0}, \"boom\": {\"n\": 0}, \"power\": {\"n\": 0}, \"win\": {\"n\": 0}, \"lose\": {\"n\": 0}}}}",
      "reducer": "(\n  $t := $action.type;\n  $s := $state;\n  $snd := $s.sound;\n  $p := $snd.play;\n  $n := function($k){ $type($lookup($p, $k)) = \"object\" ? $lookup($p, $k).n : $lookup($p, $k) };\n  $withSound := function($patch){ $merge([$s, {\"sound\": $merge([$snd, $patch])}]) };\n  $bump := function($k, $extra){ $merge([$p, {$k: $merge([{\"n\": $n($k) + 1}, $extra])}]) };\n  $t = \"coin\" ? (\n    $c := $s.combo + 1;\n    $merge([$withSound({\"play\": $bump(\"coin\", {\"pitch\": $min([$c - 1, 12])})}), {\"score\": $s.score + $c, \"combo\": $c}])\n  ) :\n  $t = \"hit\" ? $merge([$withSound({\"play\": $bump(\"hit\", {})}), {\"combo\": 0}]) :\n  $t in [\"jump\", \"boom\", \"power\", \"win\", \"lose\"] ? $withSound({\"play\": $bump($t, {})}) :\n  $t = \"music\" ? $withSound({\"music\": $action.payload}) :\n  $t = \"mute\" ? $withSound({\"muted\": $not($snd.muted)}) :\n  $t = \"pause\" ? $withSound({\"paused\": $not($snd.paused)}) :\n  $s\n)",
      "budget-ms": "40"
     }
    },
